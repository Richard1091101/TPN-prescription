  "clinical_guidelines_and_formulas": [
    {
      "category": "電解質濃度上限 (每 1000 ml)",
      "parameter": "Potassium (K)",
      "rule_or_note": "Max 80 mEq（輕度低血鉀每日補充約 75 mmol/day；週邊靜脈上限約 40 mEq/L）"
    },
    {
      "category": "電解質濃度上限 (每 1000 ml)",
      "parameter": "Magnesium (Mg)",
      "rule_or_note": "Max 15 mEq"
    },
    {
      "category": "電解質濃度上限 (每 1000 ml)",
      "parameter": "Phosphate (P)",
      "rule_or_note": "Max 30 mmol（避免與鈣過量併用產生 CaPO4 沉澱）"
    },
    {
      "category": "電解質濃度上限 (每 1000 ml)",
      "parameter": "Sodium (Na)",
      "rule_or_note": "依臨床需求調整，週邊靜脈常見上限約 75 mEq"
    },
    {
      "category": "校正公式",
      "parameter": "校正白蛋白鈣 (Corrected Ca)",
      "rule_or_note": "Corrected Ca = 0.8 × (4.0 - Alb g/dL) + 血鈣值"
    },
    {
      "category": "校正公式",
      "parameter": "鈉離子缺損量 (Na deficit)",
      "rule_or_note": "Na deficit (mmol) = (Na_d - Na_o) × 0.6 × kg"
    },
    {
      "category": "校正公式",
      "parameter": "輸注後血鈉變化",
      "rule_or_note": "Change in [Na]_serum = ([Na]_inf - [Na]_serum) ÷ (TBW + 1)，TBW ≈ kg × 0.6"
    },
    {
      "category": "特殊疾病配方特性",
      "parameter": "Renal 配方 (7%)",
      "rule_or_note": "EAA : NEAA = 6 : 4，約 250 kcal/bag"
    },
    {
      "category": "特殊疾病配方特性",
      "parameter": "Hepatic 配方 (8%)",
      "rule_or_note": "BCAA 含量較高，約 500 kcal/bag；可減緩肝腦病變惡化，但無法預防膽汁鬱積副作用（與 Dextrose 相關，必要時需調降或停用）"
    },
    {
      "category": "微量元素與礦物質",
      "parameter": "Trace Element / Zn / Cu",
      "rule_or_note": "Trace Element 僅於處方額外加入時標示；額外補充微量礦物質時可先將 TPN 中的 Zn、Cu 拿掉或避免拮抗"
    },
    {
      "category": "輸注速率與監測",
      "parameter": "Dextrose 輸注上限",
      "rule_or_note": "Dextrose 輸注速率 < 0.25 g/kg/hr（避免高血糖與肝脂肪變性）"
    },
    {
      "category": "輸注速率與監測",
      "parameter": "起始與監測",
      "rule_or_note": "TPN 起始常由 30 ml/hr 開始逐步調升至 Target（例如 1680 ml / 19 hr ≈ 88 ml/hr）；需定期監測血糖 (QWI / Trace) 與感染徵象"
    }
  ]
}