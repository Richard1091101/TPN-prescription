        // --- 其他連動函數 ---
        function updateSubVol(prefix) {
            const selKey = document.getElementById(`${prefix}_sub_sel`).value;
            const vials = parseFloat(document.getElementById(`${prefix}_sub_vials`).value) || 0;
            const volInput = document.getElementById(`${prefix}_sub_vol`);
