        }

        function autoFillBagVol(prefix, catId) {
            const selKey = document.getElementById(`${prefix}_${catId}_sel`).value;
            if (catId === 'main') updateMainDetail(prefix); 
            if (catId === 'main' && selKey) {
                let bagSize = 1000;
                if (selKey === 'smof_c') bagSize = 1477;
                if (selKey === 'smof_p') bagSize = 1448;
                if (selKey === 'periolimel') bagSize = 1500;
                if (['ntuh1','ntuh2','ntuh3','ntuh4','ntuh5','bfluid'].includes(selKey)) bagSize = 500;
                
                document.getElementById(`${prefix}_${catId}_vol`).value = bagSize;
                syncVol(`${prefix}_${catId}`, false); 
            }
        }

        function updateMainDetail(prefix) {
            const toggle = document.getElementById(`${prefix}_main_custom_toggle`);
            if (toggle && toggle.checked) return; 

            const selKey = document.getElementById(`${prefix}_main_sel`).value;
            const keys = ['kcal', 'protein', 'lipid', 'cho', 'na', 'k', 'p', 'ca', 'mg', 'zn'];
            keys.forEach(key => {
                const input = document.getElementById(`${prefix}_main_val_${key}`);
                if (input) {
                    if (selKey && db.main[selKey]) {
                        let val = (db.main[selKey][key] * 1000).toFixed(1);
                        if (key === 'p') {
                            input.innerHTML = `<option value="${val}">${val}</option>`;
                            input.value = val;
                        } else {
                            input.value = val;
                        }
                    } else {
                        if (key === 'p') input.innerHTML = '';
                        else input.value = '';
                    }
                }
            });
        }

        function toggleMainCustom(prefix) {
            const isCustom = document.getElementById(`${prefix}_main_custom_toggle`).checked;
            const keys = ['kcal', 'protein', 'lipid', 'cho', 'na', 'k', 'p', 'ca', 'mg', 'zn'];
            keys.forEach(key => {
                const input = document.getElementById(`${prefix}_main_val_${key}`);
                if (input) {
                    if (isCustom) {
                        if (key === 'p') {
                            input.removeAttribute('disabled');
                            const currentVal = parseFloat(input.value) || 0;
                            const allowedP = [0, 6.75, 13.5, 20];
                            const nearest = allowedP.reduce((prev, curr) => Math.abs(curr - currentVal) < Math.abs(prev - currentVal) ? curr : prev);
                            input.innerHTML = allowedP.map(v => `<option value="${v}" ${v === nearest ? 'selected' : ''}>${v}</option>`).join('');
                        } else {
                            input.removeAttribute('readonly');
                        }
                        input.classList.remove('bg-gray-50', 'text-gray-600', 'border-gray-200');
                        input.classList.add('bg-white', 'text-indigo-700', 'border-indigo-400', 'shadow-inner');
                    } else {
                        if (key === 'p') input.setAttribute('disabled', true);
                        else input.setAttribute('readonly', true);
                        input.classList.add('bg-gray-50', 'text-gray-600', 'border-gray-200');
                        input.classList.remove('bg-white', 'text-indigo-700', 'border-indigo-400', 'shadow-inner');
                    }
                }
            });
            if (!isCustom) updateMainDetail(prefix);
            updateAnalysis();
        }

        function syncVol(id, isRateToVol) {
            const rateEl = document.getElementById(`${id}_rate`);
            const volEl = document.getElementById(`${id}_vol`);
            if (isRateToVol) {
                const rate = parseFloat(rateEl.value);
                volEl.value = isNaN(rate) ? '' : Math.round(rate * 24);
            } else {
                const vol = parseFloat(volEl.value);
                rateEl.value = isNaN(vol) ? '' : (vol / 24).toFixed(1);
            }
            updateAnalysis();
        }

        // --- 目標需求計算 ---
        function calculateNeeds() {
            const age = parseFloat(document.getElementById('age').value);
            const height = parseFloat(document.getElementById('height').value);
            const weight = parseFloat(document.getElementById('weight').value);
            const af = parseFloat(document.getElementById('af').value);
            const sf = parseFloat(document.getElementById('sf').value);
            const gender = document.getElementById('gender').value;

            if (!age || !height || !weight) return alert("請完整填寫基礎身體參數");

            let bmr = (10 * weight) + (6.25 * height) - (5 * age) + (gender === 'male' ? 5 : -161);
            
            patientNeeds.kcal = Math.round(bmr * af * sf);
            const protFactor = sf >= 2.0 ? 2.0 : (sf >= 1.5 ? 1.7 : 1.2);
            patientNeeds.protein = weight * protFactor;
            patientNeeds.lipid = weight * 1.0; 
            patientNeeds.cho = Math.max(0, (patientNeeds.kcal - (patientNeeds.protein * 4) - (patientNeeds.lipid * 9)) / 3.4);
            patientNeeds.na = weight * 1.5;
            patientNeeds.k = weight * 1.0;
            patientNeeds.p = weight * 0.4;
            patientNeeds.mg = weight * 0.4; 
            patientNeeds.ca = weight * 0.3; 
            patientNeeds.zn = 5.0;

            document.getElementById('tar_kcal').value = patientNeeds.kcal.toFixed(0);
            document.getElementById('tar_prot').value = patientNeeds.protein.toFixed(1);
            document.getElementById('tar_lipid').value = patientNeeds.lipid.toFixed(1);
            document.getElementById('tar_cho').value = patientNeeds.cho.toFixed(1);
            document.getElementById('tar_na').value = patientNeeds.na.toFixed(1);
            document.getElementById('tar_k').value = patientNeeds.k.toFixed(1);
            document.getElementById('tar_p').value = patientNeeds.p.toFixed(1);
            document.getElementById('tar_mg').value = patientNeeds.mg.toFixed(1);
            document.getElementById('tar_ca').value = patientNeeds.ca.toFixed(1);

            document.getElementById('targetAdjustBlock').classList.remove('hidden');
            document.getElementById('formulaSection').classList.remove('hidden');
            document.getElementById('analysisSection').classList.remove('hidden');
            document.getElementById('orderSection').classList.remove('hidden');
            setTimeout(() => { document.getElementById('formulaSection').classList.remove('opacity-0'); }, 50);

            updateAnalysis();
        }

        function applyCustomTargets() {
            patientNeeds.kcal = parseFloat(document.getElementById('tar_kcal').value) || 0;
            patientNeeds.protein = parseFloat(document.getElementById('tar_prot').value) || 0;
            patientNeeds.lipid = parseFloat(document.getElementById('tar_lipid').value) || 0;
            patientNeeds.cho = parseFloat(document.getElementById('tar_cho').value) || 0;
            patientNeeds.na = parseFloat(document.getElementById('tar_na').value) || 0;
            patientNeeds.k = parseFloat(document.getElementById('tar_k').value) || 0;
            patientNeeds.p = parseFloat(document.getElementById('tar_p').value) || 0;
            patientNeeds.mg = parseFloat(document.getElementById('tar_mg').value) || 0;
            patientNeeds.ca = parseFloat(document.getElementById('tar_ca').value) || 0;
            updateAnalysis();
        }

        // --- 計算單一配方狀態 ---
        function calculateFormulaState(prefix) {
            let res = { kcal:0, protein:0, lipid:0, cho:0, na:0, k:0, p:0, ca:0, mg:0, zn:0, volume:0 };
            
            categories.forEach(cat => {
                if (cat.id === 'main') {
                    const isCustom = document.getElementById(`${prefix}_main_custom_toggle`).checked;
                    const vol = parseFloat(document.getElementById(`${prefix}_main_vol`).value) || 0;
                    res.volume += vol;
                    
                    if (isCustom) {
                        const keys = ['kcal', 'protein', 'lipid', 'cho', 'na', 'k', 'p', 'ca', 'mg', 'zn'];
                        keys.forEach(key => {
                            const valPerL = parseFloat(document.getElementById(`${prefix}_main_val_${key}`).value) || 0;
                            res[key] += valPerL * (vol / 1000);
                        });
                    } else {
                        const selKey = document.getElementById(`${prefix}_main_sel`).value;
                        if (selKey && db.main[selKey]) {
                            const data = db.main[selKey];
                            const keys = ['kcal', 'protein', 'lipid', 'cho', 'na', 'k', 'p', 'ca', 'mg', 'zn'];
                            keys.forEach(key => {
                                res[key] += data[key] * vol;
                            });
                        }
                    }
                    return;
                }

                const selKey = document.getElementById(`${prefix}_${cat.id}_sel`).value;
                if (!selKey || !db[cat.id][selKey]) return;
                
                const data = db[cat.id][selKey];
                let vol = 0;

                if (cat.id === 'trace' || cat.id === 'sub') {
                    const vials = parseFloat(document.getElementById(`${prefix}_${cat.id}_vials`).value) || 0;
                    vol = vials * data.vialVol;
                } else {
                    vol = parseFloat(document.getElementById(`${prefix}_${cat.id}_vol`).value) || 0;
                }
                
                res.kcal += data.kcal * vol;
                res.protein += data.protein * vol;
                res.lipid += data.lipid * vol;
                res.cho += data.cho * vol;
                res.na += data.na * vol;
                res.k += data.k * vol;
                res.p += data.p * vol;
                res.ca += data.ca * vol;
                res.mg += data.mg * vol;
                res.zn += data.zn * vol;
                res.volume += vol;
            });

            const addRows = document.querySelectorAll(`#${prefix}_add_container .add-row`);
            addRows.forEach(row => {
                const selKey = row.querySelector('.add-sel').value;
                if (!selKey || !db.add[selKey]) return;
                
                const data = db.add[selKey];
                const vials = parseFloat(row.querySelector('.add-pc').value) || 0;
                const vol = vials * data.vialVol;
                
                res.kcal += data.kcal * vol;
                res.protein += data.protein * vol;
                res.lipid += data.lipid * vol;
                res.cho += data.cho * vol;
                res.na += data.na * vol;
                res.k += data.k * vol;
                res.p += data.p * vol;
                res.ca += data.ca * vol;
                res.mg += data.mg * vol;
                res.zn += data.zn * vol;
                res.volume += vol;
            });

            return res;
        }

        // --- 自動計算微量元素調劑比例 ---
        function updateTraceRatio(prefix) {
            const mainVol = parseFloat(document.getElementById(`${prefix}_main_vol`).value) || 0;
            const traceSel = document.getElementById(`${prefix}_trace_sel`).value;
            const traceVials = parseFloat(document.getElementById(`${prefix}_trace_vials`).value) || 0;
            const ratioInput = document.getElementById(`${prefix}_trace_ratio`);
            
            if (mainVol > 0 && traceSel && traceVials > 0) {
                const traceVol = traceVials * db.trace[traceSel].vialVol;
                const mainLiters = mainVol / 1000;
                const ratio = (traceVol / mainLiters).toFixed(1);
                ratioInput.value = `${ratio} ml / L`;
            } else {
                ratioInput.value = '';
            }
        }

        // --- 等碳水起始流速換算 ---
        function updateSuggestedRate() {
            const box = document.getElementById('suggested_rate_box');
            if (!box) return;

            const curState = calculateFormulaState('curr');
            const curCho = curState.cho;
            const newMainSelKey = document.getElementById('new_main_sel').value;
            
            if (!newMainSelKey || curCho <= 0) {
                box.classList.add('hidden');
                return;
            }

            let choPerMl = 0;
            if (document.getElementById('new_main_custom_toggle').checked) {
                const choPerL = parseFloat(document.getElementById('new_main_val_cho').value) || 0;
                choPerMl = choPerL / 1000;
            } else {
                choPerMl = db.main[newMainSelKey].cho;
            }

            if (choPerMl > 0) {
                const suggestedVol = curCho / choPerMl;
                const suggestedRate = suggestedVol / 24;
                document.getElementById('suggested_rate_text').innerText = suggestedRate.toFixed(1);
                box.dataset.rate = suggestedRate.toFixed(1);
                box.classList.remove('hidden');
            } else {
                box.classList.add('hidden');
            }
        }

        function applySuggestedRate() {
            const box = document.getElementById('suggested_rate_box');
            if (!box || !box.dataset.rate) return;
            document.getElementById('new_main_rate').value = box.dataset.rate;
            syncVol('new_main', true); 
        }

        // --- 一鍵複製功能 ---
        function copyCurrentToNew() {
            categories.forEach(cat => {
                document.getElementById(`new_${cat.id}_sel`).value = document.getElementById(`curr_${cat.id}_sel`).value;
                if (cat.id === 'trace' || cat.id === 'sub') {
                    document.getElementById(`new_${cat.id}_vials`).value = document.getElementById(`curr_${cat.id}_vials`).value;
                } else {
                    document.getElementById(`new_${cat.id}_rate`).value = document.getElementById(`curr_${cat.id}_rate`).value;
                    document.getElementById(`new_${cat.id}_vol`).value = document.getElementById(`curr_${cat.id}_vol`).value;
                }
            });
            
            const currMainCustom = document.getElementById('curr_main_custom_toggle').checked;
            const newMainCustomToggle = document.getElementById('new_main_custom_toggle');
            newMainCustomToggle.checked = currMainCustom;
            toggleMainCustom('new');
            
            if (currMainCustom) {
                const keys = ['kcal', 'protein', 'lipid', 'cho', 'na', 'k', 'p', 'ca', 'mg', 'zn'];
                keys.forEach(key => {
                    const src = document.getElementById(`curr_main_val_${key}`);
                    const dest = document.getElementById(`new_main_val_${key}`);
                    if (key === 'p') dest.innerHTML = src.innerHTML;
                    dest.value = src.value;
                });
            }

            updateSubVol('new');

            const currContainer = document.getElementById('curr_add_container');
            const newContainer = document.getElementById('new_add_container');
            newContainer.innerHTML = ''; 
            
            const currRows = currContainer.querySelectorAll('.add-row');
            if (currRows.length === 0) {
                addAddonRow('new');
            } else {
                currRows.forEach(row => {
                    const selVal = row.querySelector('.add-sel').value;
                    const pcVal = row.querySelector('.add-pc').value;
                    addAddonRow('new', selVal, pcVal);
                });
            }
            updateAnalysis();
        }

        // --- 產生醫囑字串 ---
        function generateOrderOutput(curState, newState) {
            const currMainSel = document.getElementById('curr_main_sel');
            const currMainName = currMainSel.value ? currMainSel.options[currMainSel.selectedIndex].text : "未選擇";
            const newMainSel = document.getElementById('new_main_sel');
            const newMainName = newMainSel.value ? newMainSel.options[newMainSel.selectedIndex].text : "未選擇";

            const text1 = `1. [目前配方] ${currMainName} Total: ${curState.kcal.toFixed(0)} kcal/day, Protein: ${curState.protein.toFixed(1)}g<br>&nbsp;&nbsp;&nbsp;[新配方] ${newMainName} Total: ${newState.kcal.toFixed(0)} kcal/day, Protein: ${newState.protein.toFixed(1)}g`;

            const mainName = newMainSel.value ? newMainSel.options[newMainSel.selectedIndex].text : "未開立";
            const mainRate = document.getElementById('new_main_rate').value || 0;
            
            const addRows = document.querySelectorAll('#new_add_container .add-row');
            let addNamesArr = [];
            addRows.forEach(row => {
                const sel = row.querySelector('.add-sel');
                const vol = row.querySelector('.add-vol').value;
                if (sel.value && vol) {
                    addNamesArr.push(` + ${sel.options[sel.selectedIndex].text} (${vol}ml)`);
                }
            });
            const addNameText = addNamesArr.join('');
            
            const traceVials = parseFloat(document.getElementById('new_trace_vials').value) || 0;
            const traceText = traceVials > 0 ? ` + 微量元素(M.T.E) ${traceVials} amp` : "";

            let startingRateText = "30";
            if (curState.cho > 0 && newMainSel.value) {
                let choPerMl = 0;
                if (document.getElementById('new_main_custom_toggle').checked) {
                     choPerMl = (parseFloat(document.getElementById('new_main_val_cho').value) || 0) / 1000;
                } else {
                     choPerMl = db.main[newMainSel.value].cho;
                }
                if (choPerMl > 0) {
                     const isoRate = (curState.cho / choPerMl) / 24;
                     startingRateText = isoRate.toFixed(0); 
                }
            }

            const weight = parseFloat(document.getElementById('weight').value) || 1;
            const newGIR = (newState.cho * 1000) / (weight * 1440);
            const girWarning = newGIR > 5 ? `<span class="text-red-400 font-bold bg-red-900/50 px-1 py-0.5 rounded ml-2">⚠️ 異常 (GIR > 5.0)</span>` : "";
            const girNote = `<br>&nbsp;&nbsp;&nbsp;<span class="text-gray-400 text-xs">※小提醒: 此處方 GIR 為 ${newGIR.toFixed(2)} mg/kg/min ${girWarning}</span>`;

            let text2 = `2. 新主配方: ${mainName} ${mainRate} ml/hr (建議起始 ${startingRateText} ml/hr，+10ml/12hr)${addNameText}${traceText}${girNote}`;
            if (!newMainSel.value) text2 = `2. 新主配方: 無`;

            const subSel = document.getElementById('new_sub_sel');
            const subName = subSel.value ? `${subSel.options[subSel.selectedIndex].text} ${document.getElementById('new_sub_vol').value}ml/day (固定 20 ml/hr)` : "無";
            const text3 = `3. 脂肪乳劑: ${subName}`;

            document.getElementById('orderOutputText').innerHTML = `${text1}<br>${text2}<br>${text3}`;
        }

        // --- 更新總表分析 ---
        function updateAnalysis() {
            if (patientNeeds.kcal === 0) return;

            updateTraceRatio('curr');
            updateTraceRatio('new');
            updateSuggestedRate();

            const curState = calculateFormulaState('curr');
            const newState = calculateFormulaState('new');
            const tbody = document.getElementById('comparisonTableBody');
            const weight = parseFloat(document.getElementById('weight').value) || 1;

            // 動態更新表格標題 (顯示全名)
            const currMainSel = document.getElementById('curr_main_sel');
            const currMainName = currMainSel.value ? currMainSel.options[currMainSel.selectedIndex].text : "未選擇配方";
            const newMainSel = document.getElementById('new_main_sel');
            const newMainName = newMainSel.value ? newMainSel.options[newMainSel.selectedIndex].text : "未選擇配方";

            document.getElementById('th_curr_provide').innerHTML = `目前提供<br><span class="text-[9px] md:text-[10px] text-gray-400 font-normal block leading-tight mt-0.5 whitespace-normal">${currMainName}</span>`;
            document.getElementById('th_new_provide').innerHTML = `新配方提供<br><span class="text-[9px] md:text-[10px] text-green-200 font-normal block leading-tight mt-0.5 whitespace-normal">${newMainName}</span>`;

            const makeRow = (label, tar, cur, curVol, newV, newVol, unit, threshold, dec) => {
                const formatGap = (provide, target, vol) => {
                    const diff = provide - target;
                    let style = "text-gray-600";
                    let icon = "";
                    if (diff < -threshold) { style = "text-red-700 font-bold bg-red-50"; icon = "↓"; }
                    else if (diff > threshold) { style = "text-blue-700 font-bold bg-blue-50"; icon = "↑"; }
                    else { style = "text-green-600 font-bold"; icon = "✓"; }
                    
                    const sign = diff > 0 ? '+' : '';
                    const liters = vol / 1000;
                    const perLText = liters > 0 ? `(${sign}${(diff/liters).toFixed(dec)} ${unit}/L)` : '';
                    
                    return { html: `<td class="p-1.5 md:p-2 ${style} leading-tight">${sign}${diff.toFixed(dec)} <span class="text-[9px] md:text-[10px] ml-1">${icon}</span><br><span class="text-[9px] md:text-[10px] text-gray-500 font-normal tracking-tighter">${perLText}</span></td>` };
                };

                const curGap = formatGap(cur, tar, curVol);
                const newGap = formatGap(newV, tar, newVol);

                const diffChange = newV - cur;
                let changeStyle = "text-gray-400";
                let changeIcon = "-";
                if (diffChange > 0.001) { changeStyle = "text-blue-600 font-bold bg-blue-50"; changeIcon = "↑ 增加"; }
                else if (diffChange < -0.001) { changeStyle = "text-red-600 font-bold bg-red-50"; changeIcon = "↓ 減少"; }
                const signChange = diffChange > 0 ? '+' : '';
                const changeHtml = `<td class="p-1.5 md:p-2 border-l border-gray-200 ${changeStyle}">${signChange}${diffChange.toFixed(dec)} <span class="text-[9px] md:text-[10px] ml-1">${changeIcon}</span></td>`;

                return `
                    <tr class="hover:bg-gray-50 border-b border-gray-100">
                        <td class="p-1.5 md:p-2 font-bold text-gray-700 text-[10px] md:text-xs">${label} <span class="text-[9px] md:text-[10px] text-gray-400">(${unit})</span></td>
                        <td class="p-1.5 md:p-2 font-bold bg-indigo-50 border-l border-indigo-100">${tar.toFixed(dec)}</td>
                        <td class="p-1.5 md:p-2 border-l border-gray-100">${cur.toFixed(dec)}</td>
                        ${curGap.html}
                        <td class="p-1.5 md:p-2 border-l border-gray-100 text-green-800 font-medium bg-green-50/30">${newV.toFixed(dec)}</td>
                        ${newGap.html}
                        ${changeHtml}
                    </tr>
                `;
            };

            const curGIR = (curState.cho * 1000) / (weight * 1440);
            const newGIR = (newState.cho * 1000) / (weight * 1440);
            
            const formatGIR = (gir) => {
                let style = "text-green-600 font-bold";
                let icon = "✓";
                if (gir > 5) {
                    style = "text-red-700 font-bold bg-red-50";
                    icon = "⚠️ 超標";
                }
                return { html: `<td class="p-1.5 md:p-2 ${style} leading-tight">${gir.toFixed(2)} <span class="text-[9px] md:text-[10px] ml-1">${icon}</span></td>` };
            };
            const curGIRFmt = formatGIR(curGIR);
            const newGIRFmt = formatGIR(newGIR);

            const diffGIR = newGIR - curGIR;
            let girChangeStyle = "text-gray-400";
            let girChangeIcon = "-";
            if (diffGIR > 0.001) { girChangeStyle = "text-blue-600 font-bold bg-blue-50"; girChangeIcon = "↑ 增加"; }
            else if (diffGIR < -0.001) { girChangeStyle = "text-red-600 font-bold bg-red-50"; girChangeIcon = "↓ 減少"; }
            const girSign = diffGIR > 0 ? '+' : '';
            const girChangeHtml = `<td class="p-1.5 md:p-2 border-l border-gray-200 ${girChangeStyle}">${girSign}${diffGIR.toFixed(2)} <span class="text-[9px] md:text-[10px] ml-1">${girChangeIcon}</span></td>`;

            let html = '';
            html += makeRow('熱量 (Kcal)', patientNeeds.kcal, curState.kcal, curState.volume, newState.kcal, newState.volume, 'kcal', 150, 0);
            html += makeRow('蛋白質 (Prot)', patientNeeds.protein, curState.protein, curState.volume, newState.protein, newState.volume, 'g', 10, 1);
            html += makeRow('脂肪 (Lipid)', patientNeeds.lipid, curState.lipid, curState.volume, newState.lipid, newState.volume, 'g', 10, 1);
            html += makeRow('碳水 (CHO)', patientNeeds.cho, curState.cho, curState.volume, newState.cho, newState.volume, 'g', 20, 1);
            
            html += `
                <tr class="hover:bg-gray-50 border-b border-gray-100">
                    <td class="p-1.5 md:p-2 font-bold text-gray-700 text-[10px] md:text-xs">GIR <span class="text-[9px] md:text-[10px] text-gray-400">(mg/kg/min)</span></td>
                    <td class="p-1.5 md:p-2 font-bold bg-indigo-50 border-l border-indigo-100">&le; 5.0</td>
                    <td class="p-1.5 md:p-2 border-l border-gray-100">${curGIR.toFixed(2)}</td>
                    ${curGIRFmt.html}
                    <td class="p-1.5 md:p-2 border-l border-gray-100 text-green-800 font-medium bg-green-50/30">${newGIR.toFixed(2)}</td>
                    ${newGIRFmt.html}
                    ${girChangeHtml}
                </tr>
            `;

            html += makeRow('鈉 (Na)', patientNeeds.na, curState.na, curState.volume, newState.na, newState.volume, 'mEq', 10, 1);
            html += makeRow('鉀 (K)', patientNeeds.k, curState.k, curState.volume, newState.k, newState.volume, 'mEq', 5, 1);
            html += makeRow('磷 (P)', patientNeeds.p, curState.p, curState.volume, newState.p, newState.volume, 'mmol', 3, 1);
            html += makeRow('鈣 (Ca)', patientNeeds.ca, curState.ca, curState.volume, newState.ca, newState.volume, 'mEq', 4, 1);
            html += makeRow('鎂 (Mg)', patientNeeds.mg, curState.mg, curState.volume, newState.mg, newState.volume, 'mEq', 4, 1);
            html += makeRow('鋅 (Zn)', patientNeeds.zn, curState.zn, curState.volume, newState.zn, newState.volume, 'mg', 1.5, 1);

            const diffVol = newState.volume - curState.volume;
            let volChangeStyle = "text-gray-400";
            let volChangeIcon = "-";
            if (diffVol > 0) { volChangeStyle = "text-blue-600 font-bold bg-blue-50"; volChangeIcon = "↑ 增加"; }
            else if (diffVol < 0) { volChangeStyle = "text-red-600 font-bold bg-red-50"; volChangeIcon = "↓ 減少"; }
            const volSign = diffVol > 0 ? '+' : '';
            const volChangeHtml = `<td class="p-1.5 md:p-2 font-black ${volChangeStyle} border-l border-gray-200">${volSign}${diffVol.toFixed(0)} <span class="text-[9px] md:text-[10px] ml-1">${volChangeIcon}</span></td>`;

            html += `
                <tr class="bg-gray-100 border-t border-gray-300">
                    <td class="p-1.5 md:p-2 font-bold text-gray-800 text-[10px] md:text-xs">總液體量 <span class="text-[9px] md:text-[10px]">(ml/d)</span></td>
                    <td class="p-1.5 md:p-2 text-gray-400 bg-indigo-50 border-l border-indigo-100">-</td>
                    <td class="p-1.5 md:p-2 font-bold text-gray-600 border-l border-gray-200">${curState.volume.toFixed(0)}</td>
                    <td class="p-1.5 md:p-2 text-gray-400">-</td>
                    <td class="p-1.5 md:p-2 font-black text-indigo-700 bg-green-50/30 border-l border-gray-200">${newState.volume.toFixed(0)}</td>
                    <td class="p-1.5 md:p-2 text-gray-400 text-[9px] md:text-[10px]">心腎功能注意</td>
                    ${volChangeHtml}
                </tr>
            `;

            tbody.innerHTML = html;
            generateOrderOutput(curState, newState);
        }
        
        window.onload = function() {
            updateMainDetail('curr');
            updateMainDetail('new');
        };
    </script>
</body>
</html>