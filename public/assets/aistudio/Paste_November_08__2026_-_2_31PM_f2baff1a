        function updateAddonVol(rowId) {
            const row = document.getElementById(`row_${rowId}`);
            if (!row) return;
            const selKey = row.querySelector('.add-sel').value;
            const vials = parseFloat(row.querySelector('.add-pc').value) || 0;
            const volInput = row.querySelector('.add-vol');
            
            if (selKey && db.add[selKey]) {
