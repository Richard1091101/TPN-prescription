<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <!-- 針對手機端優化：禁止點擊輸入框時自動放大 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>臨床 TPN 處方調整與分析系統</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        input[type=number] { -moz-appearance: textfield; }
        /* 優化滾動條外觀 */
        ::-webkit-scrollbar { height: 6px; width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-gray-100 p-2 md:p-4 min-h-screen font-sans text-gray-800">
    <div class="max-w-6xl mx-auto space-y-3 md:space-y-4">
        
        <!-- 階段一：病患需求計算 -->
        <div class="bg-white rounded-xl shadow-md p-3 md:p-6 border-t-4 border-indigo-600">
            <h1 class="text-base md:text-xl font-bold mb-3 md:mb-4 text-indigo-800 flex items-center">
                <span class="bg-indigo-600 text-white rounded-full w-5 h-5 md:w-6 md:h-6 flex items-center justify-center text-xs md:text-sm mr-2">1</span>
                病患基礎需求評估 (Target Requirements)
            </h1>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2 md:gap-3 mb-3 md:mb-4">
                <div><label class="block text-[10px] md:text-xs font-bold text-gray-500">性別</label><select id="gender" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm"><option value="male">男性</option><option value="female">女性</option></select></div>
                <div><label class="block text-[10px] md:text-xs font-bold text-gray-500">年齡</label><input type="number" id="age" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm" placeholder="歲"></div>
                <div><label class="block text-[10px] md:text-xs font-bold text-gray-500">身高 (cm)</label><input type="number" id="height" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm" placeholder="cm"></div>
                <div><label class="block text-[10px] md:text-xs font-bold text-gray-500">體重 (kg)</label><input type="number" id="weight" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm" placeholder="kg"></div>
                <div>
                    <label class="block text-[10px] md:text-xs font-bold text-gray-500">活動因子 (AF)</label>
                    <select id="af" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm">
                        <option value="1.0">臥床/呼吸器 (1.0)</option>
                        <option value="1.1">輪椅/輕度床邊 (1.1)</option>
                        <option value="1.2">輕度活動/走動 (1.2)</option>
                        <option value="1.3">中度活動 (1.3)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] md:text-xs font-bold text-gray-500">壓力因子 (SF)</label>
                    <select id="sf" class="w-full border rounded p-1.5 md:p-2 mt-1 text-xs md:text-sm">
                        <option value="1.0">無壓力/營養不良 (1.0)</option>
                        <option value="1.1">輕微手術/發燒 (1.1)</option>
                        <option value="1.2">一般大手術/骨折 (1.2)</option>
                        <option value="1.3">嚴重創傷/頭外傷 (1.3)</option>
                        <option value="1.4">敗血症 (1.4)</option>
                        <option value="1.5">重症/嚴重感染 (1.5)</option>
                        <option value="1.7">大燒傷 &lt; 20% (1.7)</option>
                        <option value="2.0">嚴重燒傷 &gt; 20% (2.0)</option>
                    </select>
                </div>
            </div>
            
            <button onclick="calculateNeeds()" class="w-full bg-indigo-600 text-white py-2 md:py-2 rounded font-bold text-sm md:text-base hover:bg-indigo-700 transition shadow">計算目標需求</button>

            <!-- 可手動調整的目標需求區塊 -->
            <div id="targetAdjustBlock" class="mt-3 md:mt-4 p-2 md:p-4 bg-indigo-50 border border-indigo-200 rounded-lg hidden">
                <h3 class="font-bold text-indigo-800 text-xs md:text-sm mb-2 md:mb-3 flex items-center">
                    <span class="mr-1">🎯</span> 目標需求微調 (將連動分析)
                </h3>
                <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-9 gap-1 md:gap-2">
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">熱量(kcal)</label><input type="number" id="tar_kcal" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">Prot(g)</label><input type="number" id="tar_prot" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">Lipid(g)</label><input type="number" id="tar_lipid" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">CHO(g)</label><input type="number" id="tar_cho" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">Na(mEq)</label><input type="number" id="tar_na" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">K(mEq)</label><input type="number" id="tar_k" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">P(mmol)</label><input type="number" id="tar_p" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">Mg(mEq)</label><input type="number" id="tar_mg" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                    <div><label class="block text-[9px] md:text-[10px] text-gray-500">Ca(mEq)</label><input type="number" id="tar_ca" class="w-full border rounded p-1 text-center text-xs md:text-sm font-bold text-indigo-700" oninput="applyCustomTargets()"></div>
                </div>
            </div>
        </div>

        <!-- 階段二：配方輸入 (左右對照) -->
        <div id="formulaSection" class="grid grid-cols-1 lg:grid-cols-2 gap-3 md:gap-4 hidden opacity-0 transition-opacity duration-500">
            
            <!-- 左側：目前配方 -->
            <div class="bg-white rounded-xl shadow-md p-3 md:p-6 border-t-4 border-gray-500">
                <h2 class="text-base md:text-lg font-bold mb-3 md:mb-4 text-gray-700 flex items-center">
                    <span class="bg-gray-500 text-white rounded-full w-5 h-5 md:w-6 md:h-6 flex items-center justify-center text-xs md:text-sm mr-2">2</span>目前配方 (Current)
                </h2>
                <div id="curr_inputs" class="space-y-2 md:space-y-3">
                    <!-- JS 動態生成 -->
                </div>
            </div>

            <!-- 右側：新配方調整 -->
            <div class="bg-white rounded-xl shadow-md p-3 md:p-6 border-t-4 border-green-500">
                <h2 class="text-base md:text-lg font-bold mb-3 md:mb-4 text-green-700 flex items-center">
                    <span class="bg-green-500 text-white rounded-full w-5 h-5 md:w-6 md:h-6 flex items-center justify-center text-xs md:text-sm mr-2">3</span>新配方調整 (Proposed)
                </h2>
                <div id="new_inputs" class="space-y-2 md:space-y-3">
                    <!-- JS 動態生成 -->
                </div>
                <button onclick="copyCurrentToNew()" class="mt-3 md:mt-4 w-full text-xs md:text-sm bg-green-50 text-green-700 border border-green-200 py-2 rounded font-bold hover:bg-green-100 transition shadow-sm">
                    複製「目前配方」至此進行微調 ➔
                </button>
            </div>
        </div>

        <!-- 階段三：三維綜合分析報表 -->
        <div id="analysisSection" class="bg-white rounded-xl shadow-md p-3 md:p-6 border-t-4 border-blue-600 hidden">
            <h1 class="text-base md:text-xl font-bold mb-3 md:mb-4 text-blue-800 flex items-center">
                <span class="bg-blue-600 text-white rounded-full w-5 h-5 md:w-6 md:h-6 flex items-center justify-center text-xs md:text-sm mr-2">4</span>
                臨床差距分析 (Gap Analysis)
            </h1>
            
            <div class="overflow-x-auto rounded border border-gray-200">
                <table class="w-full text-left whitespace-nowrap">
                    <thead class="bg-gray-800 text-white text-[10px] md:text-sm">
                        <tr>
                            <th class="p-1.5 md:p-2">營養項目</th>
                            <th class="p-1.5 md:p-2 bg-indigo-900 border-l border-gray-600">🎯 目標需求</th>
                            <th id="th_curr_provide" class="p-1.5 md:p-2 border-l border-gray-600 text-gray-300">目前提供</th>
                            <th class="p-1.5 md:p-2">目前落差</th>
                            <th id="th_new_provide" class="p-1.5 md:p-2 border-l border-gray-600 text-green-300">新配方提供</th>
                            <th class="p-1.5 md:p-2">新配方落差</th>
                            <th class="p-1.5 md:p-2 border-l border-gray-600 text-yellow-300 bg-gray-700">新舊落差 (變更)</th>
                        </tr>
                    </thead>
                    <tbody id="comparisonTableBody" class="divide-y divide-gray-200 bg-white">
                        <!-- JS 動態生成 -->
                    </tbody>
                </table>
            </div>

            <div class="mt-3 md:mt-4 flex flex-wrap gap-2 md:gap-4 text-[10px] md:text-xs text-gray-500 bg-gray-50 p-2 rounded">
                <div class="flex items-center"><span class="w-2.5 h-2.5 md:w-3 md:h-3 bg-red-100 border border-red-300 inline-block mr-1"></span> 供應不足</div>
                <div class="flex items-center"><span class="w-2.5 h-2.5 md:w-3 md:h-3 bg-blue-100 border border-blue-300 inline-block mr-1"></span> 供應過量</div>
                <div class="flex items-center"><span class="font-bold text-green-600 mr-1">✓</span> 達標</div>
            </div>
            
            <div class="mt-2 md:mt-3 p-2 md:p-3 bg-indigo-50 border border-indigo-100 rounded text-[10px] md:text-xs text-gray-600 shadow-sm">
                <p class="font-bold text-indigo-800 mb-1">📚 目標需求實證來源:</p>
                <ul class="list-disc pl-4 space-y-0.5 md:space-y-1">
                    <li><strong>熱量:</strong> Mifflin-St Jeor (1990) 乘以活動與壓力因子。</li>
                    <li><strong>蛋白質/脂肪:</strong> 依據 ASPEN 指引 (蛋白質 1.2-2.0 g/kg/d；脂肪約 1.0 g/kg/d)。</li>
                    <li><strong>碳水(CHO):</strong> [總熱量-(蛋白質x4)-(脂肪x9)] ÷ 3.4 估算。</li>
                    <li><strong>電解質:</strong> 依據 ASPEN 建議值估算。</li>
                </ul>
            </div>
        </div>

        <!-- 階段四：醫囑輸出區 -->
        <div id="orderSection" class="bg-gray-800 rounded-xl shadow-md p-3 md:p-6 border-t-4 border-yellow-500 hidden text-gray-100">
            <h1 class="text-base md:text-xl font-bold mb-3 md:mb-4 text-yellow-400 flex items-center">
                <span class="bg-yellow-500 text-gray-900 rounded-full w-5 h-5 md:w-6 md:h-6 flex items-center justify-center text-xs md:text-sm mr-2">5</span>
                建議醫囑開立 (Prescription Order)
            </h1>
            <div class="bg-gray-900 p-3 md:p-4 rounded border border-gray-700 font-mono text-[11px] md:text-sm leading-relaxed text-green-400 shadow-inner overflow-x-auto" id="orderOutputText">
                <!-- JS 動態生成 -->
            </div>
            <p class="text-[9px] md:text-xs text-gray-400 mt-2 text-right">※ 請複製上方文字並於 HIS 系統中確認後開立。</p>
        </div>

    </div>

    <script>
        // --- 核心資料庫：每 1 毫升 (per ml) 之營養素含量 ---
        const db = {
            main: {
                '': { name: '-- 選擇主配方 --', kcal:0, protein:0, lipid:0, cho:0, na:0, k:0, p:0, ca:0, mg:0, zn:0 },
                'smof_c': { name: "SmofKabiven Central (1477ml)", kcal: 1.083, protein: 0.0507, lipid: 0.0385, cho: 0.0846, na: 0.0406, k: 0.0304, p: 0.0128, ca: 0.0050, mg: 0.0100, zn: 0.0026 },
                'smof_p': { name: "SmofKabiven PI (1448ml)", kcal: 0.691, protein: 0.0317, lipid: 0.0283, cho: 0.0711, na: 0.0248, k: 0.0193, p: 0.0082, ca: 0.0030, mg: 0.0062, zn: 0 },
                'periolimel': { name: "PeriOlimel N4E (1500ml)", kcal: 0.700, protein: 0.0253, lipid: 0.0300, cho: 0.0750, na: 0.0210, k: 0.0160, p: 0.0084, ca: 0.0040, mg: 0.0044, zn: 0 },
                'std_a5d21': { name: "TPN Standard A5D21 (1000ml)", kcal: 0.914, protein: 0.0500, lipid: 0, cho: 0.2100, na: 0.0450, k: 0.0280, p: 0.0135, ca: 0.0040, mg: 0.0200, zn: 0.0028 },
                'hn': { name: "TPN High Nitrogen (1000ml)", kcal: 0.801, protein: 0.0600, lipid: 0, cho: 0.1650, na: 0.0300, k: 0.0280, p: 0.0135, ca: 0.0040, mg: 0.0200, zn: 0.0028 },
                'hepatic': { name: "TPN Hepatic (1000ml)", kcal: 0.809, protein: 0.0450, lipid: 0, cho: 0.1850, na: 0.0300, k: 0.0280, p: 0.0135, ca: 0.0040, mg: 0.0200, zn: 0.0028 },
                'renal': { name: "TPN Renal (1000ml)", kcal: 0.905, protein: 0.0350, lipid: 0, cho: 0.2250, na: 0, k: 0, p: 0, ca: 0.0080, mg: 0, zn: 0.0011 },
                'ntuh1': { name: "台大1號 (500ml)", kcal: 0.152, protein: 0, lipid: 0, cho: 0.0380, na: 0.025, k: 0.018, p: 0.006, ca: 0, mg: 0.006, zn: 0 },
                'ntuh2': { name: "台大2號 (500ml)", kcal: 0.132, protein: 0, lipid: 0, cho: 0.0330, na: 0.040, k: 0.012, p: 0.006, ca: 0, mg: 0, zn: 0 },
                'ntuh3': { name: "台大3號 (500ml)", kcal: 0.080, protein: 0, lipid: 0, cho: 0.0200, na: 0.075, k: 0.012, p: 0.006, ca: 0, mg: 0, zn: 0 },
                'ntuh4': { name: "台大4號 (500ml)", kcal: 0.032, protein: 0, lipid: 0, cho: 0.0080, na: 0.110, k: 0.020, p: 0.012, ca: 0, mg: 0, zn: 0 },
                'ntuh5': { name: "台大5號 (500ml)", kcal: 0.320, protein: 0, lipid: 0, cho: 0.1000, na: 0.036, k: 0.018, p: 0.012, ca: 0, mg: 0.006, zn: 0 },
                'bfluid': { name: "BFLUID 必扶力 (500ml)", kcal: 0.375, protein: 0.0300, lipid: 0, cho: 0.0750, na: 0.035, k: 0.020, p: 0.010, ca: 0.0045, mg: 0.0050, zn: 0 }
            },
            sub: { 
                '': { name: '-- 選擇脂肪乳劑 --', kcal:0, protein:0, lipid:0, cho:0, na:0, k:0, p:0, ca:0, mg:0, zn:0, vialVol: 0 },
                'smof20_250': { name: "SMOFlipid 20% (250ml)", kcal: 2.0, protein: 0, lipid: 0.2, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 250 },
                'smof20_100': { name: "SMOFlipid 20% (100ml)", kcal: 2.0, protein: 0, lipid: 0.2, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 100 },
                'smof10_100': { name: "SMOFlipid 10% (100ml)", kcal: 1.1, protein: 0, lipid: 0.1, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 100 }
            },
            trace: {
                '': { name: '-- 選擇微量元素 --', kcal:0, protein:0, lipid:0, cho:0, na:0, k:0, p:0, ca:0, mg:0, zn:0, vialVol: 0 },
                'addamel': { name: "Addamel N (10ml/支)", kcal: 0, protein: 0, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0.65, vialVol: 10 }
            },
            add: {
                '': { name: '-- 選擇添加單方 --', kcal:0, protein:0, lipid:0, cho:0, na:0, k:0, p:0, ca:0, mg:0, zn:0, vialVol: 0 },
                'amino10': { name: "10% Amino Acid (500ml)", kcal: 0.4, protein: 0.1, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 500 },
                'nacl3': { name: "3% NaCl (500ml)", kcal:0, protein:0, lipid: 0, cho:0, na: 0.513, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 500 },
                'kcl15': { name: "15% KCl (20ml)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 2.0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 20 },
                'mgso4': { name: "10% MgSO4 (20ml)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0.8, zn: 0, vialVol: 20 },
                'cagluc': { name: "10% Ca Gluconate (20ml)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0.46, mg: 0, zn: 0, vialVol: 20 },
                'kphos': { name: "K-Phosphate (20ml)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 1.45, p: 1.0, ca: 0, mg: 0, zn: 0, vialVol: 20 },
                'lyo_povigen': { name: "Lyo-Povigen (無Vit.K 1set)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 10 },
                'lyo_povigent': { name: "Lyo-Povigent (含Vit.K 1set)", kcal:0, protein:0, lipid: 0, cho:0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0, vialVol: 10 }
            }
        };

        let patientNeeds = { kcal: 0, protein: 0, lipid: 0, cho: 0, na: 0, k: 0, p: 0, ca: 0, mg: 0, zn: 0 };

        const categories = [
            { id: 'main', label: '主配方 (含台大液/必扶力)', bg: 'bg-indigo-50 border-indigo-200' },
            { id: 'sub', label: '脂肪乳劑 (Lipid)', bg: 'bg-blue-50 border-blue-200' },
            { id: 'trace', label: '微量元素', bg: 'bg-teal-50 border-teal-200' }
        ];

        // --- 防呆與限制檢查函數 ---
        function enforceLimits(input, key) {
            let val = parseFloat(input.value);
            if (isNaN(val)) return;
            const limits = { 'na': 100, 'k': 88, 'mg': 75, 'zn': 10 };
            if (limits[key] !== undefined && val > limits[key]) {
                input.value = limits[key];
                input.classList.add('bg-red-200', 'text-red-800');
                setTimeout(() => input.classList.remove('bg-red-200', 'text-red-800'), 400);
            }
        }

        // --- 建立 UI 介面 (高度行動端優化) ---
        function buildFormulaInputs(prefix) {
            let html = categories.map(cat => {
                let options = Object.keys(db[cat.id]).map(key => `<option value="${key}">${db[cat.id][key].name}</option>`).join('');
                
                // 微量元素 UI
                if (cat.id === 'trace') {
                    return `
                        <div class="p-2 md:p-3 rounded border ${cat.bg} flex flex-col gap-2">
                            <div class="flex flex-col lg:flex-row lg:items-center gap-2">
                                <div class="w-full lg:w-1/3">
                                    <label class="block text-[10px] md:text-xs font-bold text-gray-600 mb-1">${cat.label}</label>
                                    <select id="${prefix}_${cat.id}_sel" class="w-full border rounded p-1.5 md:p-2 text-xs md:text-sm bg-white" onchange="updateAnalysis()">
                                        ${options}
                                    </select>
                                </div>
                                <div class="w-full lg:w-2/3 flex items-end space-x-1 md:space-x-2">
                                    <div class="flex-1">
                                        <label class="block text-[9px] md:text-[10px] text-gray-500 mb-1">支 (Amp)</label>
                                        <input type="number" id="${prefix}_${cat.id}_vials" class="w-full border rounded p-1.5 md:p-2 text-xs md:text-sm font-bold text-teal-700 bg-white" placeholder="ex: 1" step="0.5" oninput="updateAnalysis()">
                                    </div>
                                    <div class="pb-1.5 md:pb-2 text-gray-400 text-[10px] md:text-xs font-bold">➔</div>
                                    <div class="flex-[1.5]">
                                        <label class="block text-[9px] md:text-[10px] text-teal-700 font-bold mb-1">調劑指示 (ml/L)</label>
                                        <input type="text" id="${prefix}_${cat.id}_ratio" class="w-full border rounded p-1.5 md:p-2 text-xs md:text-sm bg-teal-100/50 text-teal-800 font-bold" placeholder="自動計算" readonly>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }
                
                // 脂肪乳劑 UI
                if (cat.id === 'sub') {
                    return `
